# Maloba — environment variables. Copy to `app/.env` (gitignored) and fill in.
# Only PUBLIC / anon keys belong here — EXPO_PUBLIC_* vars are bundled into the client.
# See docs/02-tech-stack.md.

# Google Gemini (free — Google AI Studio). Used at AUTHOR time to draft Child/translation text.
EXPO_PUBLIC_GEMINI_API_KEY=

# Lelapa AI / Vulavula (trial) — indigenous-language transcription/translation (Community Archive).
EXPO_PUBLIC_LELAPA_API_KEY=

# Supabase (free tier) — cloud archive. Anon key is safe ONLY with Row-Level Security enabled.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# hCaptcha SITEKEY (public — safe to bundle). Only needed if CAPTCHA protection is enabled on the
# Supabase project. The hCaptcha SECRET goes ONLY in the Supabase dashboard, never here.
# hCaptcha's always-pass TEST sitekey for local dev: 10000000-ffff-ffff-ffff-000000000001
EXPO_PUBLIC_HCAPTCHA_SITEKEY=

# Botlhale AI (via contact) — indigenous-language neural Text-to-Speech for the Reader's "Listen"
# button. When unset, the app falls back to free on-device speech automatically (still works offline).
# Voices Setswana, isiZulu, isiXhosa, Sesotho, Sepedi, Xitsonga and Tshivenda (not siSwati/isiNdebele).
# Set ONE credential:
#   REFRESH_TOKEN (preferred) — from POST /auth/login on your Botlhale account. It does not expire;
#     the app trades it for a 24-hour IdToken itself (POST /auth/generate).
#   API_KEY — a ready Bearer *IdToken*. Stops working after 24 hours.
# WARNING: EXPO_PUBLIC_* values are bundled into the web app, so anyone can read them. A refresh
# token never expires — revoke it (POST /auth/revoke_token) after a demo, same as the ElevenLabs key
# (EL-06, issue #43). BASE_URL is optional: default https://api.botlhale.xyz — set it to
# https://api-dev.botlhale.xyz if the contact points you at the dev host.
EXPO_PUBLIC_BOTLHALE_REFRESH_TOKEN=
EXPO_PUBLIC_BOTLHALE_API_KEY=
EXPO_PUBLIC_BOTLHALE_BASE_URL=
# ORG_ID is needed for the translation API (used offline by `npm run gen:drafts` to pre-generate
# machine-draft translations for the 9 not-yet-reviewed SA languages). Ask the contact for it.
EXPO_PUBLIC_BOTLHALE_ORG_ID=

# ElevenLabs — the narration voice for the languages ElevenLabs actually speaks.
#
# WHICH LANGUAGES. Verified against GET /v1/models on 30 Aug 2026: of our eleven, ElevenLabs covers
# ENGLISH and AFRIKAANS only. None of the nine indigenous languages appears in any of its models.
# The app will NEVER send them there — it does not error on unsupported text, it returns fluent,
# confident, wrong pronunciation, and shipping that as the voice of Setswana literature is exactly
# what AGENTS.md §4 forbids. Botlhale stays first choice for those nine; on-device is the floor.
#
# ⚠️  BUNDLED TO THE CLIENT. Anything prefixed EXPO_PUBLIC_ is compiled into the web bundle and is
#     readable by anyone who opens the deployed site. This is a PAID account with a monthly character
#     allowance, so a leaked key is someone else spending Tumo's quota. Set this only for the demo,
#     and ROTATE IT after the event. For anything longer-lived, put a tiny proxy in front of it and
#     point EXPO_PUBLIC_ELEVENLABS_BASE_URL at the proxy instead of shipping the key.
#
# QUOTA. Starter tier = 40 000 characters/month. One reader passage is ~800. The app caches every
# clip (IndexedDB on web) keyed on text+language+voice, so the same passage is only ever paid for
# once — that cache is what makes the Listen button survive a whole month.
EXPO_PUBLIC_ELEVENLABS_API_KEY=
# Optional. Defaults to Amara — Warm African-British (fFAtoTPtP0TtMyhbR3L9), chosen 30 Aug 2026 from
# the four South African voices on the account (also Declan – SA News, Andreas, Travis).
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
# Author-time only, NOT bundled: for scripts that pre-render narration rather than calling live.
ELEVENLABS_API_KEY=

# Anthropic (Claude) — two uses:
#  1) BUILD-TIME translation: `npm run gen:claude-drafts` reads ANTHROPIC_API_KEY (NOT bundled) to
#     draft the 9 not-yet-reviewed SA languages into src/content/drafts.data.ts (labelled "unreviewed").
#  2) RUNTIME chatbot: the in-app "Ask Ubuntu" guide reads EXPO_PUBLIC_ANTHROPIC_API_KEY (bundled to
#     the client for the demo — ROTATE IT after the event). Navigation + site answers work WITHOUT a key.
# You can use the same key value for both lines.
ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Optional: override the chatbot model (default claude-opus-4-8; claude-haiku-4-5 is faster/cheaper).
EXPO_PUBLIC_CHATBOT_MODEL=

# Pollinations.ai needs NO key.
# ElevenLabs IS called at runtime (Listen, English + Afrikaans only, cached) — see the block above.
