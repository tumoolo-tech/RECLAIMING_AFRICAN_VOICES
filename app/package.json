{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/spectral": "^0.4.1",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@supabase/supabase-js": "^2.110.1",
    "expo": "~56.0.12",
    "expo-audio": "~56.0.12",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.11",
    "expo-linear-gradient": "~56.0.4",
    "expo-speech": "~56.0.3",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8081",
    "web:fresh": "node scripts/web-fresh.mjs",
    "build:web": "expo export --platform web && node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-dist.mjs",
    "typecheck": "node --stack-size=8000 ./node_modules/typescript/lib/tsc.js --noEmit",
    "test": "node scripts/run-ts.mjs --test \"src/**/*.test.ts\" \"api/**/*.test.mjs\"",
    "api:dev": "node scripts/api-dev.mjs",
    "ingest": "node scripts/run-ts.mjs scripts/ingest.mjs",
    "supabase:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/supabase-check.mjs",
    "check:place-links": "node scripts/run-ts.mjs scripts/check-place-links.mjs",
    "gen:topics": "node scripts/run-ts.mjs scripts/gen-topics.mjs",
    "check:topic-links": "node scripts/run-ts.mjs scripts/check-topic-links.mjs",
    "check:languages": "node scripts/run-ts.mjs scripts/check-languages.mjs",
    "fetch:place-photo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-place-photo.mjs",
    "gen:drafts": "node scripts/run-ts.mjs scripts/generate-draft-translations.mjs",
    "gen:claude-drafts": "node scripts/run-ts.mjs scripts/generate-claude-translations.mjs",
    "gen:images": "node scripts/run-ts.mjs scripts/generate-scene-images.mjs",
    "gen:journey-images": "node scripts/run-ts.mjs scripts/generate-journey-images.mjs",
    "gen:sounds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-animal-sounds.mjs",
    "import:sounds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-animal-sounds.mjs",
    "webp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/convert-webp.mjs",
    "cache:images": "node scripts/run-ts.mjs scripts/cache-scene-images.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "review:sheet": "node scripts/run-ts.mjs scripts/gen-review-sheet.mjs",
    "fetch:text": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-wikisource.mjs"
  },
  "private": true
}
