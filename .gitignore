# dependencies
node_modules/
app/node_modules/

# expo / react native
app/.expo/
app/dist/
app/web-build/
*.orig.*
.expo-shared/

# native
app/ios/
app/android/
*.apk
*.aab
*.ipa

# env & secrets — never commit keys
.env
.env.local
app/.env
app/.env.local
*.pem
*.key

# misc
.DS_Store
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
coverage/

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# keep the hackathon source PDFs as reference (tracked on purpose)

# Language review sheets (issue #38) — generated by `npm run review:sheet`.
# Not committed: a sheet goes stale the moment a string changes, and a reviewer working from a stale
# sheet wastes their time. Generate a fresh one when you send it. A RETURNED sheet is the opposite —
# it is the record of what a person said, so review/returned/ is tracked.
review/*.md
!review/README.md

# Scratch input for `npm run fetch:text` (issue #33). The fetched .txt is re-creatable by re-running
# the script; the copy that matters is the one `npm run ingest` writes into
# app/src/content/sources/<id>/source.txt, which is the verbatim layer the citations point at.
# Committing both would put the same novel in the repo twice.
tmp/
