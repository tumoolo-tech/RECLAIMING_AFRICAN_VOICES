# Maloba — environment variables. Copy to `app/.env` (gitignored) and fill in.
# See docs/02-tech-stack.md.
#
# TWO KINDS OF VARIABLE — keep them apart (issue #43):
#   EXPO_PUBLIC_*  is compiled into the web bundle and readable by anyone who opens the site.
#                  Only URLs and keys that are MEANT to be public go here (Supabase anon + RLS,
#                  the hCaptcha sitekey). NEVER a paid or quota-bearing key.
#   everything else is server-only: read by the /api proxy (app/api/*.mjs — Vercel functions, or
#                  `npm run api:dev` locally) and by the author-time scripts. On Vercel, set these in
#                  Project Settings → Environment Variables; they never reach the browser.

# ─────────────────────────────── PUBLIC (bundled) ───────────────────────────────

# Supabase (free tier) — cloud archive. Anon key is safe ONLY with Row-Level Security enabled.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# hCaptcha SITEKEY (public — safe to bundle). Only needed if CAPTCHA protection is enabled on the
# Supabase project. The hCaptcha SECRET goes ONLY in the Supabase dashboard, never here.
# hCaptcha's always-pass TEST sitekey for local dev: 10000000-ffff-ffff-ffff-000000000001
EXPO_PUBLIC_HCAPTCHA_SITEKEY=

# Where the /api proxy lives. Leave EMPTY for the deployed web app (same origin). Set it for the
# native app (e.g. https://<the deployed site>) or for local dev against `npm run api:dev`
# (http://localhost:8787). A URL, not a secret. Without a reachable proxy the app still works:
# Listen uses the on-device voice and Ask Ubuntu answers from the site's own content.
EXPO_PUBLIC_API_BASE_URL=

# ─────────────────────── SERVER-ONLY: the /api proxy's keys ───────────────────────

# Origins other than the site itself that may call the proxy from a browser, comma-separated.
# `npm run api:dev` defaults this to the Expo web dev server (http://localhost:8081).
ALLOWED_ORIGINS=

# ElevenLabs — narration for the languages ElevenLabs actually speaks (/api/tts).
#
# WHICH LANGUAGES. Verified against GET /v1/models on 30 Aug 2026: of our eleven, ElevenLabs covers
# ENGLISH and AFRIKAANS only. None of the nine indigenous languages appears in any of its models.
# The proxy will NEVER send them there — ElevenLabs does not error on unsupported text, it returns
# fluent, confident, wrong pronunciation, and shipping that as the voice of Setswana literature is
# exactly what AGENTS.md §4 forbids. Botlhale stays first choice for those nine; on-device is the floor.
#
# QUOTA. Starter tier = 40 000 characters/month. One reader passage is ~800. The app caches every
# clip (IndexedDB on web) keyed on text+language+voice, so the same passage is only ever paid for
# once, and the proxy rate-limits per IP. Also read by the author-time narration scripts.
ELEVENLABS_API_KEY=
# Optional. Defaults to Amara — Warm African-British (fFAtoTPtP0TtMyhbR3L9), chosen 30 Aug 2026 from
# the four South African voices on the account (also Declan – SA News, Andreas, Travis).
ELEVENLABS_VOICE_ID=

# Botlhale AI (via contact) — indigenous-language neural speech (/api/tts) and translation (author-time
# `npm run gen:drafts`). Voices Setswana, isiZulu, isiXhosa, Sesotho, Sepedi, Xitsonga and Tshivenda
# (not siSwati/isiNdebele). Set ONE credential:
#   REFRESH_TOKEN (preferred) — from POST /auth/login. It does not expire; the proxy trades it for a
#     24-hour IdToken itself (POST /auth/generate). Revoke with POST /auth/revoke_token if it leaks.
#   API_KEY — a ready Bearer *IdToken*. Stops working after 24 hours.
# BASE_URL is optional: default https://api.botlhale.xyz (https://api-dev.botlhale.xyz for the dev host).
BOTLHALE_REFRESH_TOKEN=
BOTLHALE_API_KEY=
BOTLHALE_BASE_URL=
# ORG_ID is needed only by the translation script. Ask the contact for it.
BOTLHALE_ORG_ID=

# Anthropic (Claude) — two uses, one key:
#  1) RUNTIME chatbot: the "Ask Ubuntu" guide's replies (/api/chat). Navigation and site answers
#     work WITHOUT any key.
#  2) BUILD-TIME translation: `npm run gen:claude-drafts` drafts the 9 not-yet-reviewed SA languages
#     into src/content/drafts.data.ts (labelled "unreviewed").
ANTHROPIC_API_KEY=
# Optional: override the chatbot model (default claude-opus-4-8; claude-haiku-4-5 is faster/cheaper).
CHATBOT_MODEL=

# Google Gemini (free — Google AI Studio). The chatbot's fallback when there is no Anthropic key
# (/api/chat), and the author-time image scripts.
GEMINI_API_KEY=
# Optional: override the Gemini chat model (default gemini-2.5-flash).
GEMINI_CHAT_MODEL=

# Lelapa AI / Vulavula (trial) — indigenous-language transcription/translation. Not called at runtime
# yet; when it is, it goes through the proxy like the others.
LELAPA_API_KEY=

# Pollinations.ai needs NO key and stays client-side (docs/02 hard rule).
